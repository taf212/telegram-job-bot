# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000

# ── Meta WhatsApp Cloud API ────────────────────────────────────────────────────
# https://developers.facebook.com/apps/ → votre app → WhatsApp → Configuration
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxx          # Token d'accès permanent
WHATSAPP_PHONE_NUMBER_ID=123456789012345      # ID du numéro d'expéditeur
WHATSAPP_VERIFY_TOKEN=mon_token_secret_webhook # Token libre choisi par vous

# ── Google Sheets ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs → Sheets API → Service Account
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_SHEET_LATEST=latest_results
GOOGLE_SHEET_HISTORY=history

# ── Adzuna API ─────────────────────────────────────────────────────────────────
# https://developer.adzuna.com/ (gratuit, 250 req/mois)
ADZUNA_APP_ID=xxxxxxxx
ADZUNA_APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADZUNA_COUNTRY=fr

# ── France Travail API ─────────────────────────────────────────────────────────
# https://francetravail.io/produits-partages/catalogue-api/api-offres-demploi
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# ── JSearch (RapidAPI) ─────────────────────────────────────────────────────────
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# ── Cache ──────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300
